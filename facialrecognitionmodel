p":1773999917694,"user_tz":-180,"elapsed":38295,"user":{"displayName":"Brian Mutembei","userId":"03080902781752444711"}},"outputId":"0e10014e-d949-4cd0-9739-aa6e07829b6a"},"source":["TRAIN_DIR = 'images/train'\n","TEST_DIR  = 'images/test'\n","\n","def createdataframe(dir):\n","    image_paths, labels = [], []\n","    for label in os.listdir(dir):\n","        label_dir = os.path.join(dir, label)\n","        if not os.path.isdir(label_dir):\n","            continue\n","        for imagename in os.listdir(label_dir):\n","            image_paths.append(os.path.join(label_dir, imagename))\n","            labels.append(label)\n","        print(label, 'completed')\n","    return image_paths, labels\n","\n","train_df = pd.DataFrame()\n","train_df['image'], train_df['label'] = createdataframe(TRAIN_DIR)\n","\n","test_df = pd.DataFrame()\n","test_df['image'], test_df['label'] = createdataframe(TEST_DIR)\n","\n","print('\\nTrain samples:', len(train_df))\n","print('Test  samples:', len(test_df))\n","print('Classes:', sorted(train_df['label'].unique()))"],"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["angry completed\n","disgust completed\n","fear completed\n","happy completed\n","surprise completed\n","neutral completed\n","sad completed\n","fear completed\n","disgust completed\n","neutral completed\n","sad completed\n","surprise completed\n","angry completed\n","happy completed\n","\n","Train samples: 28709\n","Test  samples: 7178\n","Classes: ['angry', 'disgust', 'fear', 'happy', 'neutral', 'sad', 'surprise']\n"]}]},{"cell_type":"markdown","metadata":{"id":"cell_md_step5"},"source":["## Step 5 — Extract Features & Normalise"]},{"cell_type":"code","metadata":{"id":"cell_features","colab":{"base_uri":"https://localhost:8080/"},"outputId":"690b3f56-f2b0-4d45-c107-1201389730f1"},"source":["def extract_features(images):\n","    features = []\n","    for image in tqdm(images):\n","        img = load_img(image, color_mode='grayscale', target_size=(48, 48))\n","        features.append(np.array(img))\n","    features = np.array(features).reshape(-1, 48, 48, 1)\n","    return features\n","\n","print('Extracting train features...')\n","x_train = extract_features(train_df['image']) / 255.0\n","\n","print('Extracting test features...')\n","x_test = extract_features(test_df['image']) / 255.0\n","\n","print('x_train shape:', x_train.shape)\n","print('x_test  shape:', x_test.shape)"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Extracting train features...\n"]},{"output_type":"stream","name":"stderr","text":[" 20%|█▉        | 5666/28709 [11:48<2:19:43,  2.75it/s]"]}]},{"cell_type":"markdown","metadata":{"id":"cell_md_step6"},"source":["## Step 6 — Encode Labels"]},{"cell_type":"code","metadata":{"id":"cell_labels"},"source":["le = LabelEncoder()\n","le.fit(train_df['label'])\n","\n","y_train = to_categorical(le.transform(train_df['label']), num_classes=7)\n","y_test  = to_categorical(le.transform(test_df['label']),  num_classes=7)\n","\n","print('Label classes:', list(le.classes_))\n","print('y_train shape:', y_train.shape)"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"cell_md_step7"},"source":["## Step 7 — Build or Resume Model"]},{"cell_type":"code","metadata":{"id":"cell_model"},"source":["checkpoint_dir = 'checkpoints'\n","os.makedirs(checkpoint_dir, exist_ok=True)\n","\n","checkpoint_files = glob.glob(os.path.join(checkpoint_dir, '*.h5'))\n","start_epoch = 0\n","\n","if checkpoint_files:\n","    latest_checkpoint = max(checkpoint_files, key=os.path.getmtime)\n","    print('Resuming from:', latest_checkpoint)\n","    model = load_model(latest_checkpoint, compile=False)\n","    model.compile(\n","        optimizer=Adam(learning_rate=1e-4),\n","        loss='categorical_crossentropy',\n","        metrics=['accuracy']\n","    )\n","    match = re.search(r'facialemotionmodel(\\d+)_', os.path.basename(latest_checkpoint))\n","    if match:\n","        start_epoch = int(match.group(1))\n","    print('Resuming from epoch:', start_epoch)\n","\n","else:\n","    print('No checkpoint found — building model from scratch')\n","    model = Sequential([\n","        tf.keras.layers.Input(shape=(48, 48, 1)),\n","\n","        Conv2D(64,  (3, 3), padding='same', activation='relu'),\n","        BatchNormalization(),\n","        MaxPooling2D((2, 2)),   # → 24×24\n","        Dropout(0.25),\n","\n","        Conv2D(128, (3, 3), padding='same', activation='relu'),\n","        BatchNormalization(),\n","        MaxPooling2D((2, 2)),   # → 12×12\n","        Dropout(0.25),\n","\n","        Conv2D(256, (3, 3), padding='same', activation='relu'),\n","        BatchNormalization(),\n","        MaxPooling2D((2, 2)),   # → 6×6\n","        Dropout(0.25),\n","\n","        Flatten(),\n","        Dense(512, activation='relu'),\n","        BatchNormalization(),\n","        Dropout(0.4),\n","        Dense(256, activation='relu'),\n","        Dropout(0.3),\n","        Dense(7, activation='softmax')\n","    ])\n","    model.compile(\n","        optimizer=Adam(learning_rate=1e-3),\n","        loss='categorical_crossentropy',\n","        metrics=['accuracy']\n","    )\n","\n","model.summary()"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"cell_md_step8"},"source":["## Step 8 — Train"]},{"cell_type":"code","metadata":{"id":"cell_train"},"source":["checkpoint_cb = ModelCheckpoint(\n","    filepath=os.path.join(checkpoint_dir, 'facialemotionmodel{epoch:02d}_valacc{val_accuracy:.4f}.h5'),\n","    monitor='val_accuracy',\n","    save_best_only=True,\n","    save_weights_only=False,\n","    verbose=1\n",")\n","\n","reduce_lr_cb = ReduceLROnPlateau(\n","    monitor='val_loss',\n","    factor=0.5,\n","    patience=5,\n","    min_lr=1e-6,\n","    verbose=1\n",")\n","\n","history = model.fit(\n","    x=x_train, y=y_train,\n","    batch_size=64,\n","    epochs=100,\n","    initial_epoch=start_epoch,\n","    validation_data=(x_test, y_test),\n","    callbacks=[checkpoint_cb, reduce_lr_cb]\n",")"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"cell_md_step9"},"source":["## Step 9 — Save Final Model"]},{"cell_type":"code","metadata":{"id":"cell_save"},"source":["model_json = model.to_json()\n","with open('facialemotionmodel.json', 'w') as json_file:\n","    json_file.write(model_json)\n","\n","model.save_weights('facialemotionmodel.weights.h5')\n","model.save('facialemotionmodel.h5')\n","\n","print('✅ Model saved to:', os.path.join(BASE_DIR, 'facialemotionmodel.h5'))"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"cell_md_step10"},"source":["## Step 10 — Plot Training History"]},{"cell_type":"code","metadata":{"id":"cell_plot"},"source":["plt.figure(figsize=(12, 4))\n","\n","plt.subplot(1, 2, 1)\n","plt.plot(history.history['accuracy'],     label='Train Accuracy')\n","plt.plot(history.history['val_accuracy'], label='Val Accuracy')\n","plt.title('Model Accuracy')\n","plt.xlabel('Epoch')\n","plt.ylabel('Accuracy')\n","plt.legend()\n","\n","plt.subplot(1, 2, 2)\n","plt.plot(history.history['loss'],     label='Train Loss')\n","plt.plot(history.history['val_loss'], label='Val Loss')\n","plt.title('Model Loss')\n","plt.xlabel('Epoch')\n","plt.ylabel('Loss')\n","plt.legend()\n","\n","plt.tight_layout()\n","plt.savefig('training_history.png')\n","plt.show()\n","print('Training complete.')"],"execution_count":null,"outputs":[]}]}